{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koryphaios V5 Tauri Scenario 2",
  "version": "0.1.0",
  "identifier": "dev.koryphaios.v5.tauri.scenario2",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Koryphaios V5 Native Scenario 2",
        "width": 880,
        "height": 630,
        "resizable": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
