# Dependencies
node_modules/
desktop/src-tauri/embedded-backend/
.bun/

# Build output
build/
.svelte-kit/
backend/dist/
desktop/src-tauri/target/
# Tauri regenerates these capability/permission schemas on every build; they are
# codegen output, not source, and are not Prettier-clean by construction.
desktop/src-tauri/gen/schemas/

# Data & secrets
.koryphaios/
data/*.db
data/*.db-*
*.db
*.db-wal
*.db-shm

# Local / scratch
.devin/
.gemini/
typecheck_output*.txt
*.AppImage
test-results/
compat-hash.json

# Environment
.env
.env.local
.env.*.local
.env.pre-rotation.bak

# Test coverage output
frontend/coverage/

# Logs
*.log
*.log.*
backend/server*.log
frontend/frontend*.log
# Error-debugging MCP falls back to a cwd config only when no user config dir
# is available; keep that generated local default out of the repository.
/error-debugging-config.json

# OS
.DS_Store
Thumbs.db

# Transpiler build cache (regenerable, tens of MB per file)
*.bun-build

# Local agent-tool state
.workbuddy-ai/
.tools/

# Personal agent-tool configuration. This is a user-level file that can carry
# live provider API keys and absolute paths to machine-local plugins; it is not
# part of the Koryphaios source tree.
config.json

# IDE
.vscode/
.idea/
.cursor/
*.swp
*.swo

# Reference (excluded from repo)
opencode-reference/

# Generated audit ledger output
audit/current/

# Playwright MCP local artifacts
backend/.playwright-mcp/
.playwright-mcp/

# Ephemeral e2e test markers
PW_AGENTIC_DELETE*

# Koryphaios AI worktrees
.trees/
.claude/worktrees/
.keys
desktop/src-tauri/sidecar/
koryphaios.json

# Crash dumps and scratch build output (not source)
/outputs/skill-library-finish-plan/at-runtime/core
/.kory-tmp/**/target/

# Generated evaluation evidence, run markers and screenshots (not source).
# Keep outputs/skill-library-finish-plan/skill-gate.ts tracked; the overnight
# campaign logs and pair/blind-review trees are reproducible artifacts.
/outputs/skill-v5-pairs/
/outputs/skill-v5-blind-review/
/outputs/skill-library-finish-plan/overnight/
/outputs/*.pid
/outputs/source-refresh-*.json
/freebuff-picker-e2e.png
/freebuff-card-hours.png
/flash-fast-badge.png
