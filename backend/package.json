{
  "name": "backend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "build": "bun run typecheck && bun build src/server.ts --outdir=./build --target=bun",
    "typecheck": "tsc --noEmit",
    "test": "bun run ../scripts/test-backend-isolated.ts",
    "test:all": "bun run ../scripts/test-backend-isolated.ts",
    "test:watch": "bun run ../scripts/test-backend-isolated.ts --single-process --watch",
    "test:coverage": "bun run ../scripts/test-backend-isolated.ts --single-process --coverage --coverage-reporter=text,lcov --coverage-dir=./backend/coverage",
    "test:coverage:check": "bun run scripts/coverage-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.30.2",
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-bedrock": "^3.1106.0",
    "@aws-sdk/client-kms": "^3.1106.0",
    "@codebuff/sdk": "0.10.7",
    "@elysiajs/cors": "^1.4.2",
    "@google/genai": "^1.52.0",
    "@koryphaios/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "better-sqlite3": "^11.10.0",
    "bullmq": "5.79.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "ioredis": "5.10.1",
    "jsonwebtoken": "9.0.3",
    "nanoid": "^5.1.16",
    "openai": "^4.104.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^3.1.0",
    "reflect-metadata": "^0.2.2",
    "web-tree-sitter": "0.25.6",
    "werift": "^0.24.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
