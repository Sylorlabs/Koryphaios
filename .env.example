# Environment Variables for Koryphaios
# Copy this to .env and fill in your API keys.

# ── LLM Providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
QWEN_API_KEY=
# Alternatively, configure aliyun CLI and Qwen will auto-detect credentials:
#   npm install -g aliyun
#   aliyun configure
# CLINE_AUTH_TOKEN=
# Or authenticate via Cline CLI: cline auth

# ── Azure OpenAI ──────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# ── AWS Bedrock ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Google Cloud / Vertex AI ──────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=

# ── GitHub Copilot ────────────────────────────────────────────────────────
# Auto-detected from ~/.config/github-copilot/hosts.json
# Or set manually:
GITHUB_TOKEN=

# ── Local Model ──────────────────────────────────────────────────────────
LOCAL_ENDPOINT=

# ── Telegram Bridge ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_POLLING=true

# ── Server ────────────────────────────────────────────────────────────────
# Port 29473 is chosen to avoid common dev server conflicts (3000, 5173, 8000, 8080)
# The backend will auto-find an available port in range 29450-29500 if this is taken
# KORYPHAIOS_PORT=29473
KORYPHAIOS_HOST=127.0.0.1

# ── Security (REQUIRED) ───────────────────────────────────────────────────
# Generate these using: bun run scripts/generate-secret.ts
# Or manually with: openssl rand -hex 32
JWT_SECRET=                        # 64+ character hex string for JWT signing
KORYPHAIOS_MASTER_KEY=             # 64+ character hex string for API key encryption
SESSION_TOKEN_SECRET=              # 64+ character hex string for session tokens
KORY_APP_SECRET=                   # 64+ character hex string for app encryption

# Auth mode: "local" (single local user) or "token" (JWT/cookie required)
# Defaults to "token" in production and "local" in development.
KORYPHAIOS_AUTH_MODE=local

# ── OpenCode Zen ──────────────────────────────────────────────────────────
OPENCODE_ZEN_API_KEY=

# ── Antigravity (Google Unified Gateway) ──────────────────────────────────
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
ANTIGRAVITY_REDIRECT_URI=http://localhost:51121/oauth-callback
