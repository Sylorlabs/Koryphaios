{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kory Native Workspace Fixture",
  "version": "0.1.0",
  "identifier": "dev.koryphaios.eval.ws3ac1f486",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Native Workspace Fixture",
        "width": 640,
        "height": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
