{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Koryphaios",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-open",
    "notification:default",
    "process:default",
    "process:allow-restart",
    "clipboard-manager:default"
  ]
}