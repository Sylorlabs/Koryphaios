<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Microphone capture for voice mode (getUserMedia). Without this, signed
       macOS builds never receive the system prompt and capture fails with
       NotAllowedError even when the user would allow it. Keep this list to
       exactly what the app needs: microphone only. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
